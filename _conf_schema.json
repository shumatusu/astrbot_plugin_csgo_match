{
  "poll_enable": {
    "description": "启用后台轮询推送",
    "type": "bool",
    "default": true
  },
  "interval_live": {
    "description": "有比赛进行中/即将开赛时的轮询间隔（秒）",
    "type": "int",
    "default": 60
  },
  "interval_today": {
    "description": "今日有赛事时的轮询间隔（秒）",
    "type": "int",
    "default": 300
  },
  "interval_idle": {
    "description": "空闲时的轮询间隔（秒）",
    "type": "int",
    "default": 600
  },
  "interval_night": {
    "description": "夜间轮询间隔（秒）",
    "type": "int",
    "default": 1800
  },
  "night_start_hour": {
    "description": "夜间开始小时（0-23）",
    "type": "int",
    "default": 1
  },
  "night_end_hour": {
    "description": "夜间结束小时（0-23）",
    "type": "int",
    "default": 8
  },
  "push_map_start": {
    "description": "推送「图X开赛」通知",
    "type": "bool",
    "default": true
  },
  "push_map_end": {
    "description": "推送「图X结束」数据卡",
    "type": "bool",
    "default": true
  },
  "push_match_end": {
    "description": "推送「整场结束」总结",
    "type": "bool",
    "default": true
  },
  "max_subs_per_session": {
    "description": "单个会话最大订阅数",
    "type": "int",
    "default": 10
  },
  "push_preview": {
    "description": "赛前预告推送",
    "type": "bool",
    "default": true,
    "hint": "开赛前推一张卡：谁打谁 + 支持率 + VRS + 热评"
  },
  "preview_minutes": {
    "description": "提前多少分钟推赛前预告",
    "type": "int",
    "default": 15,
    "hint": "在该时间窗内只推一次"
  },
  "data_source": {
    "description": "默认数据源",
    "type": "string",
    "default": "auto",
    "options": [
      "auto",
      "5eplay",
      "wanmei_data",
      "wmpvp"
    ],
    "hint": "选择获取赛事数据时优先使用的源。auto 会按 5eplay -> wanmei_data -> wmpvp 自动回退；指定具体源时不做静默切换，该源失败即报错。"
  },
  "llm_provider_id": {
    "description": "用于赛事匹配兜底的 LLM 提供商 ID",
    "type": "string",
    "default": "",
    "hint": "如果留空，则自动使用 AstrBot 当前默认对话模型。如果需要独立模型，请填写 AstrBot 配置中的 Provider ID（如 'deepseek-chat'）。"
  }
}
